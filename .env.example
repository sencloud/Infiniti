# 复制为 .env 并按需修改
PORT=3100

# Neo4j（与 docker-compose.yml 保持一致）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=infiniti123

# DeepSeek（必填，否则管道无法分析）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 教材页图转写（需多模态，仅 math:fetch 用到）
DEEPSEEK_VISION_MODEL=deepseek-flash
MATH_OCR_PARALLEL=6

# 管道规模控制
MAX_PERSONS=500
MAX_DEPTH=6
CRAWL_DELAY_MS=2000

# 学习层
# 抽取方式：single（默认）或 two-pass（先对照已有实体统一称呼，再抽关系，调用量约翻倍）
KG_EXTRACT_MODE=single
# 每个 IP 每小时可触发的大模型调用（写解说、提问）
KG_LLM_PER_HOUR=40
# 审阅口令：设置后凭请求头 x-kg-review-token 才能确认/驳回事实；不设则只允许本机
KG_REVIEW_TOKEN=
# 管理口令：核对事实、新建专题、上传资料都认它（请求头 x-kg-admin-token，页面上可填）；不设则只允许本机
KG_ADMIN_TOKEN=

# 专题：扫描版 PDF 先用 poppler 的 pdftoppm 渲染成图再看图转写。pdftoppm 不在 PATH 里时填它所在的 bin 目录
POPPLER_BIN=
# 看图转写的并发数
TOPIC_OCR_PARALLEL=6

# 后台自动写解说。0 关闭；默认开启，给还没有解说的各类条目补写
KG_NOTE_AUTOFILL=1
# 每篇写完后歇多久（毫秒）。全部写完后改为每 10 分钟再扫一遍新条目
KG_NOTE_GAP_MS=2000
# 要写的语言，逗号分隔。默认只写中文，加上 en 会再写一版英文
KG_NOTE_LOCALES=zh
