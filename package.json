{
  "name": "infiniti",
  "version": "0.1.0",
  "description": "无限连接 - 关系式学习助手：AI 通读书籍、教材与资料，构建可溯源到原文的关系图谱，辅助阅读、学习与备考（DeepSeek + Neo4j + Three.js）",
  "repository": {
    "type": "git",
    "url": "https://github.com/sencloud/Infiniti.git"
  },
  "homepage": "https://github.com/sencloud/Infiniti#readme",
  "keywords": [
    "learning",
    "education",
    "reading",
    "exam-prep",
    "knowledge-graph",
    "llm",
    "deepseek",
    "neo4j",
    "threejs",
    "chinese-classics"
  ],
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/pipeline/worker.js",
    "seed": "node src/scripts/seed.js",
    "kg:run": "node src/scripts/kg/run.js",
    "kg:crawl": "node src/scripts/kg/crawl.js",
    "kg:seeds": "node src/scripts/kg/seeds.js",
    "kg:extract": "node src/scripts/kg/extract.js",
    "kg:extract-compare": "node src/scripts/kg/extract-compare.js",
    "topic:import": "node src/scripts/topic/import.js",
    "kg:load": "node src/scripts/kg/load.js",
    "kg:build": "node src/scripts/kg/build.js",
    "kg:restore": "node src/scripts/kg/restore.js",
    "shuihu:all": "node src/scripts/kg/run.js shuihu",
    "shuihu:load": "node src/scripts/kg/load.js shuihu",
    "shuihu:build": "node src/scripts/kg/build.js shuihu",
    "shuihu:media": "node src/scripts/shuihu/media.js",
    "classics:all": "node src/scripts/kg/all.js",
    "kg:covers": "node src/scripts/kg/covers.js",
    "kg:media": "node src/scripts/kg/media.js",
    "math:all": "node src/scripts/kg/run.js math",
    "math:fetch": "node src/scripts/math/fetch.js",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@node-rs/jieba": "^2.0.3",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "crawlee": "^3.18.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "ml-kmeans": "^7.0.1",
    "ml-pca": "^4.1.1",
    "neo4j-driver": "^6.2.0",
    "openai": "^7.10.0",
    "pdfjs-dist": "^4.10.38",
    "playwright-core": "^1.63.0",
    "three": "0.160.1",
    "umap-js": "^1.4.0",
    "word-extractor": "^1.0.4"
  }
}
