# 复制为 .env 并按需修改
PORT=3000

# Neo4j（与 docker-compose.yml 保持一致）
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=infiniti123

# DeepSeek（必填，否则管道无法分析）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 管道规模控制
MAX_PERSONS=500
MAX_DEPTH=6
CRAWL_DELAY_MS=2000
